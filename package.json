{
  "name": "blaze-auto-test",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "test:junit": "REPORT_JUNIT=1 playwright test --project=chromium",
    "test:k6": "find src/tests/k6 -name '*.test.ts' -exec k6 run {} +",
    "k6:cloud": "k6 cloud run --local-execution src/tests/k6/auth-performance/login-api.test.ts",
    "ci": "npm run lint && npm run test",
    "k6:type-check": "tsc --noEmit -p src/tests/k6/tsconfig.json"
  },
  "devDependencies": {
    "@types/k6": "^1.0.0",
    "@playwright/test": "1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
